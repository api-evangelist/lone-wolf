                "description": "DocumentGUID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the name of a specific document within a transaction."
        },
        {
          "info": {
            "name": "Delete a Document",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.pre.transactiondesk.com/v2/transactions/:transactionId/documents/:documentId",
            "params": [
              {
                "name": "transactionId",
                "value": "",
                "type": "path",
                "description": "TransactionGUID"
              },
              {
                "name": "documentId",
                "value": "",
                "type": "path",
                "description": "DocumentGUID"
              }
            ]
