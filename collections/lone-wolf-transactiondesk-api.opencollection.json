{
  "opencollection": "1.0.0",
  "info": {
    "name": "TransactionDesk Partner API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Exchange for Access Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pre.transactiondesk.com/oauth/token",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "grant_type",
                  "value": ""
                },
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "client_secret",
                  "value": ""
                },
                {
                  "name": "code",
                  "value": ""
                },
                {
                  "name": "redirect_uri",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Exchange an authorization code or client credentials for a bearer access token.\n\n- Use `grant_type=authorization_code` along with the `code` and `redirect_uri` from the Authorization Code flow.\n- Use `grant_type=client_credentials` for the Client Credentials flow (no user redirect required)."
        }
      ]
    },
    {
      "info": {
        "name": "Transaction Summary",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get All Transactions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pre.transactiondesk.com/v2/transactions",
            "params": [
              {
                "name": "$orderDir",
                "value": "",
                "type": "query",
                "description": "Sort direction"
              },
              {
                "name": "$skip",
                "value": "",
                "type": "query",
                "description": "Number of records to skip (pagination)"
              },
              {
                "name": "$take",
                "value": "",
                "type": "query",
                "description": "Number of records to return (max 100)"
              },
              {
                "name": "$orderBy",
                "value": "",
                "type": "query",
                "description": "Field to order by"
              }
            ]
          },
          "docs": "Returns a full list of transactions owned by the authenticated user. Supports filter params ($orderDir, $skip, $take, $orderBy)."
        },
        {
          "info": {
            "name": "Create a Transaction",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pre.transactiondesk.com/v2/transactions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new transaction file in the authenticated user's account."
        },
        {
          "info": {
            "name": "Get a Specific Transaction",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pre.transactiondesk.com/v2/transactions/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "TransactionGUID"
              }
            ]
          },
          "docs": "Returns a specific transaction file owned by the authenticated user."
        },
        {
          "info": {
            "name": "Update a Transaction",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.pre.transactiondesk.com/v2/transactions/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "TransactionGUID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates part or all of a specific transaction file."
        },
        {
          "info": {
            "name": "Delete a Transaction",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.pre.transactiondesk.com/v2/transactions/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "TransactionGUID"
              }
            ]
          },
          "docs": "Deletes a specific transaction file owned by the authenticated user."
        },
        {
          "info": {
            "name": "Get Transaction Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pre.transactiondesk.com/v2/transactions/:id/details",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "TransactionGUID"
              }
            ]
          },
          "docs": "Returns property details associated with a specified transaction file. Details are divided into three sections: property information, listing information, and sale/purchase information."
        },
        {
          "info": {
            "name": "Update Transaction Details",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.pre.transactiondesk.com/v2/transactions/:id/details",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "TransactionGUID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates part or all of the property details associated with a specified transaction file. You can update any combination of property, listing, and purchase fields."
        }
      ]
    },
