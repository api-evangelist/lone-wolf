{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authentisign API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Update Email Signature. Use this endpoint to update the email signature associated with the current account.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.lwolf.com/authentisign/api/v1/accounts/email-signature",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "emailSignature",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Sample request:\r\n            \r\n    POST /Accounts/email-signature\r\n    \"emailSignature\" : \"Best Regards, John Doe\""
        }
      ]
    },
    {
      "info": {
        "name": "CCs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve CCs for a signing. This endpoint fetches all the CCs associated with the provided signing ID.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lwolf.com/authentisign/api/v1/signings/:signingId/ccs",
            "params": [
              {
                "name": "signingId",
                "value": "",
                "type": "path",
                "description": "The identifier of the signing for which CCs are to be fetched."
              }
            ]
          },
          "docs": "Sample request:\r\n            \r\n    GET /api/v1/signings/{signingId}/CCs"
        },
        {
          "info": {
            "name": "Add CCs in batch. This endpoint allows you to add multiple CCs at once for efficient processing.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.lwolf.com/authentisign/api/v1/ccs/batch",
            "headers": [
              {
                "name": "externalId",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Sample request:\r\n            \r\n    POST /api/v1/signings/{signingId}/CCs/batch\r\n    [\r\n        {\r\n            \"id\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\r\n            \"signingId\": \"12345678-1234-1234-1234-123456789012\",\r\n            \"firstName\": \"John\",\r\n            \"middleName\": \"D\",\r\n            \"lastName\": \"Doe\",\r\n            \"email\": \"john.doe@example.com\",\r\n            \"displayOrder\": 1,\r\n            \"externalId\": \"EXT1234\",\r\n            \"transactionId\": \"9b74f03d-71d4-4911-a0d4-60c720bac"
        }
      ]
    },
    {
      "info": {
        "name": "Documents",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve signing document IDs. This endpoint fetches the document IDs associated with the provided signing ID.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lwolf.com/authentisign/api/v1/signings/:signingId/documents",
            "params": [
              {
                "name": "signingId",
                "value": "",
                "type": "path",
                "description": "The identifier of the signing for which document IDs are to be fetched."
              }
            ]
          },
          "docs": "Sample request:\r\n            \r\n    GET /api/v1/signings/{signingId}/documents"
        },
        {
          "info": {
            "name": "Apply a layout to a document within a specific signing.",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.lwolf.com/authentisign/api/v1/signings/:signingId/documents/:documentId",
            "params": [
              {
                "name": "signingId",
                "value": "",
                "type": "path",
                "description": "The identifier of the signing to which the document belongs."
              },
              {
                "name": "documentId",
                "value": "",
                "type": "path",
                "description": "The identifier of the document to which the layout is to be applied."
              },
              {
                "name": "LayoutId",
                "value": "",
                "type": "query",
                "description": "Get or Set Layout ID. This property represents the unique identifier of the document layout."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Sample request:\r\n            \r\n    PATCH /api/v1/signings/3fa85f64-5717-4562-b3fc-2c963f66afa6/documents/3fa85f64-5717-4562-b3fc-2c963f66afa7\r\n    {\r\n       \"LayoutId\": \"3fa85f64-5717-4562-b3fc-2c963f66afa8\"\r\n    }"
        },
        {
          "info": {
            "name": "Retrieve the fully executed combined signing package PDF.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lwolf.com/authentisign/api/v1/signings/:signingId/documents/s",
            "params": [
              {
                "name": "signingId",
                "value": "",
                "type": "path",
                "description": "The identifier of the signing for which the final document is to be fetched."
              }
            ]
          },
          "docs": "Sample request:\r\n            \r\n    GET /api/v1/signings/{signingId}/documents/s"
        },
        {
          "info": {
            "name": "Retrieve the URL to a fully executed combined signing package PDF.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lwolf.com/authentisign/api/v1/signings/:signingId/documents/s/url",
            "params": [
              {
                "name": "signingId",
                "value": "",
                "type": "path",
                "description": "The identifier of the signing for which the final document URL is to be fetched."
              }
            ]
          },
          "docs": "Sample request:\r\n            \r\n    GET /api/v1/signings/{signingId}/documents/s/url"
        },
        {
          "info": {
            "name": "Retrieve the signing certificate for a specific signing.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lwolf.com/authentisign/api/v1/signings/:signingId/documents/sc",
            "params": [
              {
                "name": "signingId",
                "value": "",
                "type": "path",
                "description": "The identifier of the signing for which the certificate is to be fetched."
              }
            ]
          },
          "docs": "Sample request:\r\n            \r\n    GET ~/api/v1/signings/{signingId}/documents/sc"
        },
        {
          "info": {
            "name": "Retrieve the latest signed document for a specific signing.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lwolf.com/authentisign/api/v1/signings/:signingId/documents/ls",
            "params": [
              {
                "name": "signingId",
                "value": "",
                "type": "path",
                "description": "The identifier of the signing for which the latest signed document is to be fetched."
              }
            ]
          },
          "docs": "Sample request:\r\n            \r\n    GET ~/api/v1/signings/{signingId}/documents/ls"
        },
        {
          "info": {
            "name": "Retrieve the URL to latest signed document associated with the specified signing ID.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lwolf.com/authentisign/api/v1/signings/:signingId/documents/ls/url",
            "params": [
              {
                "name": "signingId",
                "value": "",
                "type": "path",
                "description": "The identifier of the signing for which the final document URL is to be fetched."
              }
            ]
          },
          "docs": "Sample request:\r\n            \r\n    GET /api/v1/signings/{signingId}/documents/ls/url"
        },
        {
          "info": {
            "name": "Retrieve the original document using its encrypted ID.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lwolf.com/authentisign/api/v1/documents/:encryptedDocumentId/o",
            "params": [
              {
                "name": "encryptedDocumentId",
                "value": "",
                "type": "path",
                "description": "The encrypted identifier of the document to be fetched."
              }
            ]
          },
          "docs": "Sample request:\r\n            \r\n    GET /{encryptedDocumentId}/o"
        },
        {
          "info": {
            "name": "Retrieve the URL of the original document.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lwolf.com/authentisign/api/v1/documents/:documentId/o/url",
            "params": [
              {
                "name": "documentId",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the document."
              }
            ]
          },
          "docs": "Sample request:\r\n            \r\n    GET /{documentId}/o/url"
        },
        {
          "info": {
            "name": "Retrieve the final version of a document using its encrypted ID.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lwolf.com/authentisign/api/v1/documents/:encryptedDocumentId/d",
            "params": [
              {
                "name": "encryptedDocumentId",
                "value": "",
                "type": "path",
                "description": "The encrypted identifier of the document to be fetched."
              }
            ]
          },
          "docs": "Sample request:\r\n            \r\n    GET /{encryptedDocumentId}/d"
        },
        {
          "info": {
            "name": "Retrieve the URL of the final version of a document.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lwolf.com/authentisign/api/v1/documents/:documentId/d/url",
            "params": [
              {
                "name": "documentId",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the document."
              }
            ]
          },
          "docs": "Sample request:\r\n            \r\n    GET /{documentId}/d/url"
        },
        {
          "info": {
            "name": "Retrieve the certificate of a document using its encrypted ID.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lwolf.com/authentisign/api/v1/documents/:encryptedDocumentId/dc",
            "params": [
              {
                "name": "encryptedDocumentId",
                "value": "",
                "type": "path",
                "description": "The encrypted identifier of the document for which the certificate is to be fetched."
              }
            ]
          },
          "docs": "Sample request:\r\n            \r\n    GET /{encryptedDocumentId}/dc"
        },
        {
          "info": {
            "name": "Retrieve the URL of the document's certificate.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lwolf.com/authentisign/api/v1/documents/:documentId/dc/url",
            "params": [
              {
                "name": "documentId",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the document."
              }
            ]
          },
          "docs": "Sample request:\r\n            \r\n    GET /{documentId}/dc/url"
        }
      ]
    },
    {
      "info": {
        "name": "History",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve Audit Trail. This endpoint allows you to pull a list of all audit trail events related to this signing. The audit trail is also embedded into the final signed documents themselves.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lwolf.com/authentisign/api/v1/signings/:signingId/history",
            "params": [
              {
                "name": "signingId",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the signing for which the audit trail is to be fetched."
              }
            ]
          },
          "docs": "Sample request:\r\n            \r\n    GET /signings/{signingId}/history\r\n            \r\nHeader:\r\n    externalId: SomeExternalId"
        }
      ]
    },
    {
      "info": {
        "name": "Layouts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get layouts by language. This endpoint retrieves all layouts created under the account based on the specified language.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lwolf.com/authentisign/api/v1/layouts",
            "params": [
              {
                "name": "language",
                "value": "",
                "type": "query",
                "description": "The language used in the API call."
              }
            ]
          },
          "docs": "Sample request:\r\n            \r\n    GET /layouts?language=en"
        },
        {
          "info": {
            "name": "Create a new layout. This endpoint allows you to create a signature layout for future signing.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.lwolf.com/authentisign/api/v1/layouts",
            "params": [
              {
                "name": "Name",
                "value": "",
                "type": "query",
                "description": "Get or Set the Layout Name. This property represents the descriptive name of the layout."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Sample request:\r\n            \r\n    POST /layouts\r\n    {\r\n        \"name\": \"Test Layout\"\r\n    }"
        },
        {
          "info": {
            "name": "Copy an existing layout. This endpoint lets you duplicate a layout for reuse.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.lwolf.com/authentisign/api/v1/layouts/:id/copy",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the layout to copy."
              }
            ]
          },
          "docs": "Sample request:\r\n            \r\n    POST /layouts/{layoutId}/copy"
        },
        {
          "info": {
            "name": "Delete a specific layout. This endpoint removes a layout based on its ID.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.lwolf.com/authentisign/api/v1/layouts/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the layout to delete."
              }
            ]
          },
          "docs": "Sample request:\r\n            \r\n    DELETE /layouts/{LayoutId}"
        }
      ]
    },
    {
      "info": {
        "name": "Participants",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve the list of signing participants within a signing.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lwolf.com/authentisign/api/v1/signings/:signingId/participants",
            "params": [
              {
                "name": "signingId",
                "value": "",
                "type": "path",
                "description": "The identifier of the signing for which participants are to be fetched."
              }
            ]
          },
          "docs": "Sample request:\r\n            \r\n    GET /api/v1/signings/{signingId}/participants"
        },
        {
          "info": {
            "name": "Update the email address of a signing participant and resend the invitation.",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.lwolf.com/authentisign/api/v1/participants/:participantId/email",
            "params": [
              {
                "name": "participantId",
                "value": "",
                "type": "path",
                "description": "The identifier of the participant whose email is to be updated."
              },
              {
                "name": "Email",
                "value": "",
                "type": "query",
                "description": "Get or Set the email address of the participant."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Sample request:\r\n            \r\n    PATCH /api/v1/participants/{participantId}/email \r\n    {\r\n        \"email\": \"change@lwolf.com\"\r\n    }"
        },
        {
          "info": {
            "name": "Batch creation of signing participants for a signing process.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.lwolf.com/authentisign/api/v1/participants/batch",
            "headers": [
              {
                "name": "externalId",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Sample request:\r\n            \r\n    POST /api/v1/participants/batch \r\n    Header: externalId\r\n    Request Body:\r\n    [\r\n        {\r\n            \"Id\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\r\n            \"SigningId\": \"5c192f97-41e4-ed11-8e8b-00224827d18c\",\r\n            \"FirstName\": \"John\",\r\n            \"MiddleName\": \"D\",\r\n            \"LastName\": \"Doe\",\r\n            \"Email\": \"john.doe@example.com\",\r\n            \"ParticipantRole\": \"Buyer\",\r\n            \"CustomSignature\": \"JD_Signature\",\r\n            "
        }
      ]
    },
