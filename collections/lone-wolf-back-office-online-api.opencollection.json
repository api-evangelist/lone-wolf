              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new business contact for the transaction."
        },
        {
          "info": {
            "name": "Get Business Contact",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lwolf.com/backoffice/v1/business-contacts/:businessContactId",
