                "description": "The id of the business contact."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Make changes to existing business contacts."
        },
        {
          "info": {
            "name": "Delete Business Contact",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.lwolf.com/backoffice/v1/business-contacts/:businessContactId",
